# ─────────────────────────────────────────────────────────────────────────────
#  DeepInsight — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Required. Used for Haiku (classifier, planner, analyst) and Sonnet (synthesizer).
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Required. Used for live web search with Google Search grounding.
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# ─── Clerk Authentication ────────────────────────────────────────────────────
# Required. Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Neon Postgres ───────────────────────────────────────────────────────────
# Required for research history persistence.
# Get this from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────────────
# Optional. Rate-limits AI API routes (10 requests/10s per user).
# Without this, rate limiting is skipped and all requests pass through.
# Get these from https://console.upstash.com → your Redis database
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
